{
  "name": "tarot-webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.x",
    "npm": ">=11.19.1 <12"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "audit:all": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:signatures": "npm audit signatures"
  },
  "dependencies": {
    "@upstash/redis": "1.38.4",
    "framer-motion": "12.43.0",
    "lucide-react": "0.468.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "10.5.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
